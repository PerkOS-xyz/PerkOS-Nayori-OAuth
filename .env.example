NODE_ENV=development
HOST=0.0.0.0
PORT=8080
ISSUER_ORIGIN=http://localhost:8080
RESOURCE_ORIGIN=https://nayori.ai
API_ORIGIN=https://api.nayori.ai
RELEASE_SHA=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://nayori.ai,https://app.nayori.ai,https://docs.nayori.ai

DATABASE_URL=postgresql://nayori_oauth:nayori-local-only@postgres:5432/nayori_oauth
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000

STACKS_NETWORK=testnet
PARTNER_REGISTRATION_ENABLED=false
PARTNER_CHALLENGE_TTL_SECONDS=300
OAUTH_ACCESS_TOKEN_TTL_SECONDS=300
TOKEN_RATE_LIMIT_PER_MINUTE=60
REGISTRATION_RATE_LIMIT_PER_MINUTE=30
# Generate outside GitHub with: npm run oauth:keygen
# OAUTH_SIGNING_PRIVATE_JWK_JSON={"kty":"OKP","crv":"Ed25519",...}
OAUTH_PREVIOUS_PUBLIC_JWKS_JSON={"keys":[]}
